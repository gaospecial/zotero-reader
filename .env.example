# 桌面进程启动前设置；不要写入前端 VITE_ 变量。
DEEPSEEK_API_KEY=
DOC2X_API_KEY=
# 可选：覆盖模型与下载域白名单（逗号分隔）
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DOC2X_DOWNLOAD_HOSTS=doc2x.noedgeai.com,noedgeai.com,aliyuncs.com
# 可选：Zotero 数据目录；默认 ~/Zotero，也可直接指向其 storage 目录
ZOTERO_DATA_DIR=
# 可选：attachments: 链接附件所使用的根目录
ZOTERO_ROOT_DIR=
